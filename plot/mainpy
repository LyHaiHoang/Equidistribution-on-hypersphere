import sys
import pandas as pd
from PyQt5 import QtWidgets, uic
from PyQt5.QtWidgets import QFileDialog, QMessageBox
from matplotlib.backends.backend_qt5agg import FigureCanvasQTAgg as FigureCanvas
from mpl_toolkits.mplot3d import Axes3D
import matplotlib.pyplot as plt

Ui_MainWindow, QtBaseClass = uic.loadUiType("plotter.ui")

class PlotterApp(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()
        uic.loadUi("plotter.ui", self)

        # Khởi tạo figure để vẽ
        self.figure = plt.figure()
        self.canvas = FigureCanvas(self.figure)
        self.widget_plot.layout().addWidget(self.canvas)

        # Biến để lưu dữ liệu
        self.df = None

        # Kết nối nút
        self.pushButton_load.clicked.connect(self.load_data)
        self.pushButton_plot.clicked.connect(self.plot_data)

    def load_data(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "Open File", "", "Data Files (*.csv *.xlsx)")
        if file_path:
            try:
                if file_path.endswith(".csv"):
                    self.df = pd.read_csv(file_path)
                elif file_path.endswith(".xlsx"):
                    self.df = pd.read_excel(file_path)
                QMessageBox.information(self, "Success", "Dữ liệu đã được load thành công!")
                print(self.df.head())
            except Exception as e:
                QMessageBox.critical(self, "Error", f"Không thể đọc file:\n{str(e)}")

    def plot_data(self):
        if self.df is None:
            QMessageBox.warning(self, "Warning", "Chưa có dữ liệu để vẽ!")
            return

        self.figure.clear()
        plot_type = self.comboBox_plot_type.currentText().lower()

        try:
            if plot_type == "2d":
                ax = self.figure.add_subplot(111)
                ax.plot(self.df.iloc[:, 0], self.df.iloc[:, 1], marker='o')
                ax.set_xlabel(self.df.columns[0])
                ax.set_ylabel(self.df.columns[1])
                ax.set_title("Đồ thị 2D")

            elif plot_type == "3d":
                ax = self.figure.add_subplot(111, projection='3d')
                ax.plot3D(self.df.iloc[:, 0], self.df.iloc[:, 1], self.df.iloc[:, 2], marker='o')
                ax.set_xlabel(self.df.columns[0])
                ax.set_ylabel(self.df.columns[1])
                ax.set_zlabel(self.df.columns[2])
                ax.set_title("Đồ thị 3D")

            self.canvas.draw()
        except Exception as e:
            QMessageBox.critical(self, "Plot Error", f"Lỗi khi vẽ đồ thị:\n{str(e)}")

if __name__ == "__main__":
    app = QtWidgets.QApplication(sys.argv)
    window = PlotterApp()
    window.show()
    sys.exit(app.exec_())
